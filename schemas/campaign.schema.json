{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DanLoran/serving-inference/schemas/campaign.schema.json",
  "title": "Serving inference campaign definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "defaults", "workloads", "sweeps"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "name": {"$ref": "#/$defs/pathSafeName"},
    "output_root": {"type": "string", "minLength": 1},
    "defaults": {
      "type": "object",
      "required": [
        "url",
        "model",
        "model_metadata",
        "server",
        "num_requests",
        "warmups",
        "repeats",
        "seed"
      ],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_metadata": {"type": "object"},
        "server": {"type": "object"},
        "num_requests": {"type": "integer", "minimum": 1},
        "warmups": {"type": "integer", "minimum": 0},
        "repeats": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"}
      }
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "config"],
        "properties": {
          "name": {"$ref": "#/$defs/pathSafeName"},
          "config": {"type": "string", "minLength": 1}
        }
      }
    },
    "sweeps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "workload", "concurrency"],
        "properties": {
          "name": {"$ref": "#/$defs/pathSafeName"},
          "workload": {"$ref": "#/$defs/pathSafeName"},
          "concurrency": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "num_requests": {"type": "integer", "minimum": 1},
          "warmups": {"type": "integer", "minimum": 0},
          "repeats": {"type": "integer", "minimum": 1},
          "seed": {"type": "integer"}
        }
      }
    }
  },
  "$defs": {
    "pathSafeName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$",
      "not": {"enum": [".", ".."]}
    }
  }
}
